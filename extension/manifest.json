{
  "manifest_version": 3,
  "name": "Price Ghost — E-Commerce Price Tracker",
  "version": "1.0.0",
  "description": "Smart price tracker for Amazon, Flipkart, and Myntra with 1-click manual tracking and drop alerts.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.de/*",
    "*://*.flipkart.com/*",
    "*://*.myntra.com/*",
    "http://localhost:5000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:3000/*",
    "https://*.onrender.com/*",
    "https://price-ghost.onrender.com/*",
    "https://*.netlify.app/*",
    "https://price-ghost.netlify.app/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.de/*",
        "*://*.flipkart.com/*",
        "*://*.myntra.com/*"
      ],
      "js": [
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:3000/*",
        "https://*.onrender.com/*",
        "https://price-ghost.onrender.com/*",
        "https://*.netlify.app/*",
        "https://price-ghost.netlify.app/*"
      ],
      "js": [
        "src/content/webBridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Price Ghost Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
