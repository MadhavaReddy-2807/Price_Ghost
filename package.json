{
  "name": "price-ghost",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Platform E-Commerce Price Tracker Monorepo (Pure JavaScript)",
  "workspaces": [
    "server",
    "extension",
    "website"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:website": "npm --workspace=website run dev",
    "dev:extension": "npm --workspace=extension run dev",
    "start:server": "npm --workspace=server run start",
    "test:server": "npm --workspace=server run test",
    "build:extension": "npm --workspace=extension run build",
    "build:website": "npm --workspace=website run build",
    "seed": "npm --workspace=server run seed"
  },
  "keywords": [
    "price-tracker",
    "ecommerce",
    "amazon",
    "flipkart",
    "myntra",
    "chrome-extension"
  ],
  "author": "",
  "license": "MIT"
}
