# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Local MongoDB or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/price-tracker

# Authentication
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Service (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Price Ghost <your_email@gmail.com>"

# Background Engine Settings
POLL_INTERVAL_MINUTES=180
POLL_ITEM_DELAY_MS=5000
POLL_BATCH_SIZE=20
POLL_STARTUP_DELAY_MS=30000
POLL_DEBUG=true
MAX_CONCURRENT_REQUESTS=3
